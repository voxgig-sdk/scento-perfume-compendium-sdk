# API Information


main: {
  kit: {
    info: {
      auth: false
      contact: {
        email: "support@scento.com"
        name: "Scento"
        url: "https://www.scento.com/developers"
      }
      description: `Free perfume and fragrance API and MCP server for AI assistants, built on Scento's verified perfume database: notes, scent families, similar perfumes, raw materials and houses, each answer linked to a page on scento.com. Covers 1,400+ designer and niche perfumes, 400+ raw materials and 140+ perfume houses. No key, no account.

The same twelve read-only answers as the MCP server at https://www.scento.com/mcp. Every answer is a folio: a quotable lede, a detail object, the scento.com page to read on, further reading and a cite line. Lists return an opaque continuation value. Comma-separated values are accepted wherever a list is expected.`
      license: {
        name: "Scento terms of service"
        url: "https://www.scento.com/terms-of-service#perfume-api"
      }
      servers: [
        {
          url: "https://www.scento.com/api/perfume/v1"
        }
      ]
      summary: "Scento Perfume API: a free perfume and fragrance API, with the same answers as its MCP server."
      termsOfService: "https://www.scento.com/terms-of-service#perfume-api"
      title: "Scento Perfume API"
      version: "1.0.0"
      website: "https://www.scento.com/developers"
    }
  }
}

